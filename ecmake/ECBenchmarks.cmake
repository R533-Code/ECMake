include_guard(GLOBAL)

include(ECFramework)

# Generates the framework specific files of a benchmark executable
# (see `_ec_add_framework_executable`).
function(_ec_benchmarks_generate FRAMEWORK FULL_NAME GENERATED_DIR NO_MAIN OUT_SOURCES OUT_LIBRARIES OUT_INCLUDE_DIRS)
    set(_sources)
    set(_include_dirs)

    if(FRAMEWORK STREQUAL "google")
        string(CONCAT _main_content
            "// file generated by ECMake\n"
            "#include <benchmark/benchmark.h>\n"
            "\n"
            "int main(int argc, char** argv) {\n"
            "  ::benchmark::Initialize(&argc, argv);\n"
            "  if (::benchmark::ReportUnrecognizedArguments(argc, argv))\n"
            "    return 1;\n"
            "  ::benchmark::RunSpecifiedBenchmarks();\n"
            "  ::benchmark::Shutdown();\n"
            "  return 0;\n"
            "}\n"
        )
        set(_library "benchmark::benchmark")
    elseif(FRAMEWORK STREQUAL "nanobench")
        string(CONCAT _main_content
            "// file generated by ECMake\n"
            "#include <ec_nanobench.h>\n"
            "\n"
            "int main(int argc, char** argv) {\n"
            "  return ::ecmake::nanobench::run(argc, argv);\n"
            "}\n"
        )

        # the registry is generated even with NO_MAIN, so that a custom `main()`
        # can still use `BENCHMARK` and `ecmake::nanobench::run`
        set(_template_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/templates")

        # configure_file only writes the files if their content changed
        configure_file("${_template_dir}/ec_nanobench.h" "${GENERATED_DIR}/ec_nanobench.h" COPYONLY)
        configure_file("${_template_dir}/ec_nanobench.cpp" "${GENERATED_DIR}/ec_nanobench.cpp" COPYONLY)
        list(APPEND _sources "${GENERATED_DIR}/ec_nanobench.h" "${GENERATED_DIR}/ec_nanobench.cpp")
        list(APPEND _include_dirs "${GENERATED_DIR}")

        # nanobench's own CMakeLists defines `nanobench` (and the alias
        # `nanobench::nanobench` when it is not the top-level project)
        if(TARGET nanobench::nanobench OR NOT TARGET nanobench)
            set(_library "nanobench::nanobench")
        else()
            set(_library "nanobench")
        endif()
    else()
        message(FATAL_ERROR "BENCHMARK_FRAMEWORK `${FRAMEWORK}` is unknown! Valid values are: google, nanobench.")
    endif()

    if(NOT NO_MAIN)
        set(_main "${GENERATED_DIR}/ec_main.cpp")
        ec_write_file_if_changed("${_main}" "${_main_content}")
        list(APPEND _sources "${_main}")
    endif()

    set(${OUT_SOURCES} "${_sources}" PARENT_SCOPE)
    set(${OUT_LIBRARIES} "${_library}" PARENT_SCOPE)
    set(${OUT_INCLUDE_DIRS} "${_include_dirs}" PARENT_SCOPE)
endfunction()

# Creates a benchmark executable from all the `.cpp` files of ROOT_DIR, linked
# with the benchmarking framework, whose `main()` is generated (unless NO_MAIN).
# BENCH_EXEC_NAME: The name of the executable
# See the README for the arguments.
macro(ec_add_benchmarks BENCH_EXEC_NAME)
    _ec_add_framework_executable(ec_add_benchmarks BENCHMARK_FRAMEWORK benchmarks _ec_benchmarks_generate
        "${BENCH_EXEC_NAME}" ${ARGN}
    )
endmacro()

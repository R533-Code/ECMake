include_guard(GLOBAL)

include(ECFramework)

# Generates the `main()` of a test executable (see `_ec_add_framework_executable`).
function(_ec_tests_generate FRAMEWORK FULL_NAME GENERATED_DIR NO_MAIN OUT_SOURCES OUT_LIBRARIES OUT_INCLUDE_DIRS)
    if(FRAMEWORK STREQUAL "doctest")
        string(CONCAT _main_content
            "// file generated by ECMake\n"
            "#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN\n"
            "#include <doctest/doctest.h>\n"
        )
        set(_library "doctest::doctest")
    elseif(FRAMEWORK STREQUAL "catch2")
        string(CONCAT _main_content
            "// file generated by ECMake\n"
            "#include <catch2/catch_session.hpp>\n"
            "\n"
            "int main(int argc, char** argv) {\n"
            "  return Catch::Session().run(argc, argv);\n"
            "}\n"
        )
        set(_library "Catch2::Catch2")
    elseif(FRAMEWORK STREQUAL "gtest")
        string(CONCAT _main_content
            "// file generated by ECMake\n"
            "#include <gtest/gtest.h>\n"
            "\n"
            "int main(int argc, char** argv) {\n"
            "  ::testing::InitGoogleTest(&argc, argv);\n"
            "  return RUN_ALL_TESTS();\n"
            "}\n"
        )
        set(_library "GTest::gtest")
    else()
        message(FATAL_ERROR "TESTING_FRAMEWORK `${FRAMEWORK}` is unknown! Valid values are: doctest, catch2, gtest.")
    endif()

    set(_sources)

    if(NOT NO_MAIN)
        set(_main "${GENERATED_DIR}/ec_main.cpp")
        ec_write_file_if_changed("${_main}" "${_main_content}")
        list(APPEND _sources "${_main}")
    endif()

    set(${OUT_SOURCES} "${_sources}" PARENT_SCOPE)
    set(${OUT_LIBRARIES} "${_library}" PARENT_SCOPE)
    set(${OUT_INCLUDE_DIRS} "" PARENT_SCOPE)
endfunction()

# Creates a test executable from all the `.cpp` files of ROOT_DIR, linked with
# the testing framework, whose `main()` is generated (unless NO_MAIN).
# TEST_EXEC_NAME: The name of the executable
# See the README for the arguments.
macro(ec_add_tests TEST_EXEC_NAME)
    _ec_add_framework_executable(ec_add_tests TESTING_FRAMEWORK tests _ec_tests_generate
        "${TEST_EXEC_NAME}" ${ARGN}
    )
endmacro()
